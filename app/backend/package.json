{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "predev": "node scripts/copy-shared.js",
    "dev": "nodemon server.js",
    "prestart": "node scripts/copy-shared.js",
    "start": "node server.js",
    "db:generate": "node scripts/prisma-generate.js",
    "postinstall": "node scripts/prisma-generate.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:start": "node scripts/db-ctl.js start",
    "db:stop": "node scripts/db-ctl.js stop",
    "db:migrate-prescriptions": "node scripts/migratePrescriptionFiles.js",
    "test": "node --test \"test/**/*.js\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "seed:orders": "node scripts/seedOrders.js",
    "db:import-sqlite": "node scripts/migrateSqliteToPg.js",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "6.19.3"
  }
}
