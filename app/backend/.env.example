PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Railway: mount volume at /data and set DATA_DIR=/data (prescriptions + uploads)
# DATA_DIR=/data

# PostgreSQL (docker compose: npm run db:up)
DATABASE_URL="postgresql://vita24:vita24@localhost:5432/vita24_db?schema=public"

# SQLite manbasi faqat bir martalik ko'chirish uchun (npm run db:import-sqlite)
# SQLITE_PATH="prisma/dev.db"

# Kamida 32 ta tasodifiy belgi. "change-me" ishlatmang.
JWT_SECRET="replace-with-48-plus-random-characters-not-a-placeholder"
JWT_EXPIRES_IN="7d"
# Super admin access token. Refresh token 14 kun saqlanadi.
ADMIN_JWT_EXPIRES_IN="12h"

# Reverse proxy ortida 1 yoki true (Railway: 1). Bo'sh — soxta X-Forwarded-For qabul qilinmaydi.
TRUST_PROXY=

# Lekko kalitlarini shifrlash (kamida 32 belgi)
LEKKO_KEY_SECRET="replace-with-another-48-plus-random-characters"

SEED_ADMIN_PASSWORD=""
SEED_PHARMACIST_PASSWORD=""

# OTP kodini mijoz Telegramiga yuboradi (@BotFather).
# Shop settings dagi token ustun; bo'sh bo'lsa shu env olinadi.
# Polling faqat BITTA backend instance'da ishlasin (Railway replica = 1).
TELEGRAM_BOT_TOKEN=""
# @Belgisisiz username, masalan Vita24Bot. Bot ishga tushgach getMe ham to'ldiradi.
TELEGRAM_BOT_USERNAME=""
# Telegram WebApp tugmasi. Faqat https qabul qilinadi (http da WebApp tugmasi chiqmaydi).
WEBAPP_URL=""

# Dev yordamchilari — productionda YOQILMASIN (server ishga tushmaydi)
# ENABLE_MOCK_PAY=true
# ENABLE_DEV_OTP=true

CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

LEKKO_API_URL="https://pharmalekko.uz/api/public/v1"
LEKKO_API_KEY=""
LEKKO_BRANCH_ID="branch-yunusobod"
LEKKO_DRUGSTORE_ID=118
LEKKO_TIMEOUT_MS=15000
LEKKO_PAGE_SIZE=500
LEKKO_CATALOG_MAX_PAGES=5
LEKKO_SYNC_ENABLED=true
LEKKO_SYNC_INTERVAL_MS=600000
LEKKO_BRANCH_GAP_MS=300
