{
  "installCommand": "npm install --include=optional && npm install --include=optional --no-save --no-package-lock @rollup/rollup-linux-x64-gnu@4.62.5 @tailwindcss/oxide-linux-x64-gnu@4.3.3 lightningcss-linux-x64-gnu@1.32.0",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
