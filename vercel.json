{
  "installCommand": "npm install --prefix app/frontend --include=optional --no-package-lock --workspaces=false",
  "buildCommand": "node app/frontend/scripts/ensure-linux-binaries.mjs && npx --prefix app/frontend vite build",
  "outputDirectory": "app/frontend/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
